{
  "name": "objectflow-studio",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:doppler": "doppler run -- turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "secrets:list": "doppler secrets",
    "secrets:pull": "doppler secrets download --no-file --format env"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "prettier": "^3.4.2"
  }
}
