# ============================================================================
# ObjectFlow Studio — environment variables
# Copy to .env.local for local dev; set in Vercel/Railway dashboards for deploys.
# ============================================================================

NODE_ENV=development

# ----- Database (Railway Postgres) -----
DATABASE_URL=postgresql://user:password@host:5432/objectflow
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/objectflow

# ----- Redis (Railway) -----
REDIS_URL=redis://default:password@host:6379

# ----- Auth0 -----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.objectflow.studio
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_SECRET=
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com

# ----- Anthropic -----
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_REASONING_MODEL=claude-opus-4-7

# ----- Inngest -----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# ----- Cloudflare R2 -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=objectflow-uploads
R2_PUBLIC_URL=

# ----- Langfuse -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ----- Sentry -----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ----- Better Stack (Logs) -----
LOGTAIL_SOURCE_TOKEN=

# ----- Worker service (internal) -----
WORKER_URL=http://localhost:4000
WORKER_INTERNAL_SECRET=

# ----- Web app -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WORKER_URL=
