# D: drive is exFAT — no symlink support, so we use hoisted mode (flat
# node_modules, like npm/yarn classic). Trade off: lose strict isolation
# (phantom-dep imports become possible), node_modules grows. Acceptable
# given our deps are explicit. If/when D: is reformatted to NTFS, remove
# node-linker=hoisted to restore pnpm's strict symlinked layout.
node-linker=hoisted

link-workspace-packages=true
prefer-workspace-packages=true
shared-workspace-lockfile=true
auto-install-peers=true
strict-peer-dependencies=false
