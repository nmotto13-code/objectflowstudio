# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
build/
dist/
*.tsbuildinfo

# Turbo cache
.turbo/

# Environment / secrets — never commit
# Catch-all: ignores .env, .env.local, .env.recheck, .env.vercel.*,
# .env.pull, and any other .env.<suffix>. The negation keeps the
# .env.example placeholder template tracked.
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# Local backups of pre-Doppler env files (D: only, never push)
.local-backups/

# Drizzle metadata
drizzle/meta/

# Misc
*.pem
coverage/
graphify-out/
